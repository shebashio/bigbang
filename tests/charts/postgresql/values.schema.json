{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["istio", "cluster", "database", "readiness"],
  "properties": {
    "fullnameOverride": { "type": "string", "minLength": 1 },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "istio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambient"],
      "properties": {
        "ambient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "gitlabNamespace", "operator"],
          "properties": {
            "enabled": { "type": "boolean" },
            "gitlabNamespace": { "type": "string", "minLength": 1 },
            "operator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "serviceAccount"],
              "properties": {
                "namespace": { "type": "string", "minLength": 1 },
                "serviceAccount": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instances", "imageName", "postgresUID", "postgresGID", "storage", "resources", "postgresql"],
      "properties": {
        "instances": { "type": "integer", "minimum": 1 },
        "imageName": { "type": "string", "minLength": 1 },
        "postgresUID": { "type": "integer", "minimum": 1 },
        "postgresGID": { "type": "integer", "minimum": 1 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": { "size": { "type": "string", "minLength": 1 } }
        },
        "resources": { "type": "object" },
        "postgresql": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameters", "sharedPreloadLibraries"],
          "properties": {
            "parameters": { "type": "object", "additionalProperties": { "type": "string" } },
            "sharedPreloadLibraries": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "credentials", "postInitApplicationSQL"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "secretName", "username", "password"],
          "properties": {
            "existingSecret": { "type": "string" },
            "secretName": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string", "minLength": 1 }
          }
        },
        "postInitApplicationSQL": { "type": "array", "items": { "type": "string" } }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "intervalSeconds", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    }
  }
}
